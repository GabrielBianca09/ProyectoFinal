-- ELIMINAR Y CREAR BASE DE DATOS -------------------------------------------

DROP DATABASE IF EXISTS gestion_hotelera;

CREATE DATABASE gestion_hotelera
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE gestion_hotelera;


--  TABLA HOTELES --------------------------------------------------------


CREATE TABLE hoteles (
    id_hotel INT AUTO_INCREMENT PRIMARY KEY,
    nombre_hotel VARCHAR(100) NOT NULL,
    direccion_hotel VARCHAR(200) NOT NULL,
    numero_contacto_hotel VARCHAR(30) NOT NULL
);


-- TABLA EMPLEADOS ------------------------------------------------


CREATE TABLE empleados (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    dni VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(120),
    numero_celular VARCHAR(30),

    horas_trabajadas INT NOT NULL,
    direccion VARCHAR(200),
    salario_base DECIMAL(12,2) NOT NULL,

    id_hotel INT NOT NULL,

    FOREIGN KEY (id_hotel)
        REFERENCES hoteles(id_hotel)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


-- TABLA PASAJEROS


CREATE TABLE pasajeros (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    dni VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(120),
    numero_celular VARCHAR(30),

    direccion_origen VARCHAR(200)
);

-- TABLA ADMINISTRADORES ---------------------------------------------

CREATE TABLE administradores (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_admin INT NOT NULL UNIQUE,

    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100) NOT NULL,
    dni VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(120),
    numero_celular VARCHAR(30),

    nombre_usuario VARCHAR(50) NOT NULL UNIQUE,
    clave VARCHAR(255) NOT NULL
);



-- TABLA HABITACIONES -------------------------------------------------


CREATE TABLE habitaciones (
    numero_habitacion INT AUTO_INCREMENT PRIMARY KEY,

    capacidad_ocupantes INT NOT NULL,

    id_hotel INT NOT NULL,

    estado_habitacion ENUM(
        'DISPONIBLE',
        'RESERVADA',
        'EN_MANTENIMIENTO'
    ) NOT NULL DEFAULT 'DISPONIBLE',

    tipo_habitacion ENUM(
        'suite',
        'simple',
        'presidencial'
    ) NOT NULL,

    FOREIGN KEY (id_hotel)
        REFERENCES hoteles(id_hotel)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CHECK (capacidad_ocupantes > 0)
);

-- TABLA TRABAJOS DE EMPLEADOS ------------------------------------------------

CREATE TABLE empleado_trabajos (
    id_empleado INT NOT NULL,

    tipo_trabajo ENUM(
        'ARTISTA',
        'BOTONES',
        'COCINERO',
        'CONSERJE',
        'MOZO',
        'RECEPCIONISTA'
    ) NOT NULL,

    PRIMARY KEY (id_empleado, tipo_trabajo),

    FOREIGN KEY (id_empleado)
        REFERENCES empleados(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);



-- TABLA RESERVAS --------------------------------------------


CREATE TABLE reservas (
    id_reserva INT AUTO_INCREMENT PRIMARY KEY,

    id_pasajero INT NOT NULL,

    fecha DATE NOT NULL,

    FOREIGN KEY (id_pasajero)
        REFERENCES pasajeros(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);


--  TABLA DETALLE RESERVA -----------------------------------------------


CREATE TABLE detalle_reserva (
    id_detalle INT AUTO_INCREMENT PRIMARY KEY,

    id_reserva INT NOT NULL,

    numero_habitacion INT NOT NULL,

    precio DECIMAL(12,2) NOT NULL DEFAULT 0,

    FOREIGN KEY (id_reserva)
        REFERENCES reservas(id_reserva)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (numero_habitacion)
        REFERENCES habitaciones(numero_habitacion)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CHECK (precio >= 0)
);


